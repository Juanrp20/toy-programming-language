-- programa completo de prueba
func suma(a,b)
  ret a+b
end suma

func main()
  local x := 5
  local y := 3.14
  local s1 := "hola"
  local s2 := 'mundo'
  x := suma(x, 1)
  if x > 0 then
    print x
  else
    println y
  end
  while x > 0 do
    x := x-1
  end
  for i := 1, 10, 2 do
    print i
  end
  for j := 0, 5 do
    println j
  end
  ret 0
end main()
